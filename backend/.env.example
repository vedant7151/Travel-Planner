# Groq (required) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Postgres (required) - https://supabase.com
# Use the pooled connection string and keep sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Privileged connection used only for migrations, LangGraph checkpointer, and
# system-internal trip_events/trip_errors writes. Do not expose it to clients.
SYSTEM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Supabase Auth JWT verification
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Set either the legacy JWT secret or leave blank to use the project's JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=travel-planner

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Free public APIs (no keys; overrides optional)
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRY_ATTEMPTS=3
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TravelPlanner/1.0 (educational)
NOMINATIM_EMAIL=
NOMINATIM_RESULT_LIMIT=8
OSRM_BASE_URL=https://router.project-osrm.org
DDG_MAX_RESULTS=8
DDG_REGION=wt-wt

# Rate-limit configuration. Confirm these against your provider plan.
GROQ_TPM_LIMIT=10000
GEMINI_RPM_LIMIT=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Upstash Redis REST cache, provider gates and distributed locks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# slowapi uses the standard Redis protocol; set this to the Upstash redis:// URL.
# If blank, the /plan rate limiter falls back to per-process in-memory storage.
REDIS_URL=
